# PostPilot AI environment configuration
#
# Copy this file to .env and fill in the blank values:
#
#   cp .env.example .env
#
# .env is read by Docker Compose and by host commands run with
# `uv run --env-file ../../.env ...`. It is git-ignored and must never be committed.
#
# Blank values are secrets with no default on purpose. Compose and the API both
# refuse to start until they are set.

# ---------------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------------

# One of: local, test, staging, production. Interactive API docs are disabled in production.
APP_ENV=local

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# "console" is readable for host development; "json" is machine-parseable.
# Applies to host commands only. Containers started by Compose always log JSON.
LOG_FORMAT=console

# Comma-separated list of exact browser origins allowed to call the API
# (scheme://host[:port], no path, no trailing slash). Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------------
# PostgreSQL (system of record)
# ---------------------------------------------------------------------------------

POSTGRES_DB=postpilot
POSTGRES_USER=postpilot

# Required secret. Use only letters and digits to keep it safe in every tool.
# Generate with: uv run --no-project python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# How a process running on the host reaches PostgreSQL. Compose ignores these two for
# its own containers, which always connect to postgres:5432 on the internal network.
# POSTGRES_PORT is also the port published on 127.0.0.1 by infra/docker-compose.host-dev.yml.
# Use the IP rather than "localhost": on Windows, "localhost" tries IPv6 first and adds
# about two seconds to every new connection before falling back.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------------
# Redis (queue infrastructure)
# ---------------------------------------------------------------------------------

# Required secret. Used by Celery as the message broker (Phase 4A).
# Generate with: uv run --no-project python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=

# Host Redis settings for processes on the host. Compose containers always use redis:6379.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------------------
# Frontend and published ports
# ---------------------------------------------------------------------------------

# API origin as seen by the browser. Inlined into the web bundle at build time, so
# rebuild the web image after changing it. Must agree with API_PORT.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Frontend origin used for post-OAuth redirects (no path). Must be listed in CORS_ALLOWED_ORIGINS.
WEB_BASE_URL=http://localhost:3000

# Ports published on 127.0.0.1 by Compose.
API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------------------------
# Sessions and cookies
# ---------------------------------------------------------------------------------

# Set true when the API is served over HTTPS. Must be true when APP_ENV=production.
COOKIE_SECURE=false

# Lifetime of the opaque application session cookie, in seconds (default 14 days).
SESSION_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------------
# LinkedIn OAuth
# ---------------------------------------------------------------------------------
# Create an app at https://www.linkedin.com/developers/apps
# Products required: "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn" (for w_member_social). See docs/linkedin-oauth.md.

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must exactly match an authorized redirect URL on the LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# Space-separated OAuth scopes. Must include every required scope; the API refuses
# to start if any are missing.
LINKEDIN_SCOPES="openid profile email w_member_social"

# ---------------------------------------------------------------------------------
# Token encryption at rest
# ---------------------------------------------------------------------------------
# Base64-encoded 32-byte AES-256 key. Generate with:
#
#   uv run --no-project python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# Losing this key makes stored LinkedIn access tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------
# Scheduled posts (Phase 3)
# ---------------------------------------------------------------------------------

# Earliest allowed scheduled_at relative to "now" (seconds). Avoids near-immediate races.
SCHEDULE_MIN_LEAD_SECONDS=60

# Max post body length accepted by the API (LinkedIn commentary bound used as guidance).
POST_CONTENT_MAX_LENGTH=3000

# List pagination defaults.
POSTS_PAGE_SIZE_DEFAULT=20
POSTS_PAGE_SIZE_MAX=50

# ---------------------------------------------------------------------------------
# Background publishing (real LinkedIn is the user-facing path; fake is tests-only)
# ---------------------------------------------------------------------------------
# Safe defaults keep LinkedIn API calls off until you explicitly opt in.
# Users approve posts in the UI (confirm_publish); that stamps durable DB approval.
# For a temporary live canary of ONE post (see docs/live-e2e-publishing.md):
#   1. Schedule & confirm the post in the UI (stores DB approval)
#   2. Set PUBLISH_PROVIDER=linkedin, ENABLE_REAL_PUBLISHING=true
#   3. Keep LIVE_PUBLISH_REQUIRE_CANARY=true and set LIVE_PUBLISH_CANARY_POST_IDS=<uuid>
#   4. docker compose up -d --force-recreate api worker beat
# After a verified canary, production mode is LIVE_PUBLISH_REQUIRE_CANARY=false â€”
# DB approval remains mandatory for every post.

PUBLISH_PROVIDER=fake
ENABLE_REAL_PUBLISHING=false
FAKE_PUBLISH_DEFAULT_SCENARIO=success
ALLOW_FAKE_PUBLISHER_IN_PRODUCTION=false
LINKEDIN_API_VERSION=202611
LINKEDIN_API_BASE_URL=https://api.linkedin.com

LIVE_PUBLISH_REQUIRE_CANARY=true
LIVE_PUBLISH_CANARY_POST_IDS=

CELERY_WORKER_CONCURRENCY=2
CELERY_QUEUE_PUBLISH=publish
PUBLISH_DISPATCHER_INTERVAL_SECONDS=15
PUBLISH_RECOVERY_INTERVAL_SECONDS=30
DISPATCH_BATCH_SIZE=25
DISPATCH_LEASE_SECONDS=30
PROCESSING_LEASE_SECONDS=120
PUBLISH_RETRY_INITIAL_SECONDS=30
PUBLISH_RETRY_BACKOFF_MULTIPLIER=2
PUBLISH_RETRY_MAX_DELAY_SECONDS=900
PUBLISH_RETRY_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------------
# Phase 5A AI content assistant (drafting only — never schedules/publishes)
# ---------------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30
